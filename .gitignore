app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# =============================================================================
# DEPLOYMENT & SECURITY - DO NOT COMMIT
# =============================================================================

# Environment files with secrets
.env
.env.local
.env.*.local
backend/.env
backend/.env.local

# Keep example env files
!.env.example
!.env.development
!.env.production
!backend/.env.example
!backend/.env.development
!backend/.env.production

