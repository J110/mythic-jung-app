<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext for local development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
    
    <!-- Production domains - HTTPS only -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">mythicjung.com</domain>
        <domain includeSubdomains="true">api.mythicjung.com</domain>
    </domain-config>
    
    <!-- Base config - default to secure -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <!-- For debug builds, also trust user-installed certificates -->
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
